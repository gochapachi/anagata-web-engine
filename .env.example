# anagata-web-engine - environment
#
# Copy to .env.local for local development, or set these as Coolify env vars.
# Never commit a filled-in copy.

# ---- Supabase (required) ---------------------------------------------------
# PostgREST base. The engine reads it as ${SUPABASE_URL}/rest/v1/...
SUPABASE_URL=https://supabase.anagataitsolutions.in
# Service-role key: the engine reads across all tenants and inserts leads, so it
# needs RLS bypass. This key must NEVER reach a browser - it is only used in
# server components and route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cache revalidation (required) -----------------------------------------
# Shared secret for POST /api/revalidate. n8n sends it as x-revalidate-secret.
# Generate: openssl rand -hex 32
ENGINE_REVALIDATE_SECRET=

# ---- Compile gate (optional, recommended) ---------------------------------
# Shared secret for POST /api/compile. Leave empty to run the gate unauthenticated
# (it only compiles CSS, it cannot write anything).
ENGINE_COMPILE_SECRET=

# ---- Media proxy (optional) ------------------------------------------------
# Base URL the engine proxies /media/* to. The tenant host is appended, so a
# request for crown.com/media/a.webp becomes <base>/crown.com/a.webp.
MINIO_PUBLIC_URL=http://213.199.62.248:9000/sites

# ---- Preview domains (optional) -------------------------------------------
# Suffix used for instant preview URLs when a tenant has no custom domain yet.
SITES_BASE_DOMAIN=sites.anagataitsolutions.in